[Unit]
Description=KAGARIHI Bookkeeping Web Dashboard
After=network-online.target bookkeeping-bot.service
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/KAGARIHI_bookkeeping
EnvironmentFile=/opt/KAGARIHI_bookkeeping/.env
ExecStart=/opt/KAGARIHI_bookkeeping/venv/bin/python dashboard.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
