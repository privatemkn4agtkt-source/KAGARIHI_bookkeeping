[Unit]
Description=Cloudflare Tunnel for KAGARIHI Dashboard
After=network-online.target bookkeeping-bot.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/KAGARIHI_bookkeeping/deploy/start-tunnel.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
